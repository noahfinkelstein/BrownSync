# --- Database (supabase start prints local values) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# --- Pollers (services/poller) ---
# Contract §5: every request to Brown servers identifies itself.
POLLER_USER_AGENT=BrownSync/1.0 (+noah_finkelstein@brown.edu)

# --- API (apps/api) ---
API_PORT=8787
# Extra allowed CORS origins beyond localhost, comma-separated. Locally this
# can stay empty; the deployed Worker sets it in apps/api/wrangler.toml [vars].
CORS_ORIGINS=

# --- Web (apps/web) ---
VITE_API_URL=http://localhost:8787
# Zero-backend fixture mode (README "Quickstart"): 1 = serve the deterministic
# in-memory contract dataset for EVERY read-API route — no database, no network.
VITE_USE_FIXTURES=
VITE_PMTILES_URL=/tiles/providence.pmtiles
# Analytics is OFF unless a PostHog project key is set (src/ops/analytics.ts).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# production origin (scheme+host, no trailing slash, e.g. https://brownsync.pages.dev); build-time transform makes og:image/twitter:image absolute — REQUIRED for prod deploys
VITE_CANONICAL_ORIGIN=

# --- Deploy-time only (set as GitHub repo variables, not in any .env — DEPLOY.md) ---
# VITE_API_ORIGIN      https://brownsync-api.<subdomain>.workers.dev  (mapped to VITE_API_URL in deploy.yml)
# VITE_CANONICAL_ORIGIN https://brownsync.pages.dev                   (absolute OG/meta URLs)
