{
  "openapi": "3.1.0",
  "info": {
    "title": "BrownSync API",
    "version": "0.1.0",
    "description": "Public read endpoints and protected account operations over the BrownSync canonical schema. Consumed by apps/web and the SwiftUI client via codegen."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "local dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": ["id", "email"]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      },
      "EventsResponse": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": ["events"]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": ["string", "null"]
          },
          "allDay": {
            "type": "boolean"
          },
          "lat": {
            "type": ["number", "null"]
          },
          "lng": {
            "type": ["number", "null"]
          },
          "placeId": {
            "type": ["string", "null"]
          },
          "placeName": {
            "type": ["string", "null"]
          },
          "locationRaw": {
            "type": ["string", "null"]
          },
          "orgId": {
            "type": ["string", "null"]
          },
          "orgName": {
            "type": ["string", "null"]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": ["string", "null"]
          },
          "cost": {
            "type": ["string", "null"]
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "isCanceled": {
            "type": "boolean"
          },
          "mergedSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "start",
          "end",
          "allDay",
          "lat",
          "lng",
          "placeId",
          "placeName",
          "locationRaw",
          "orgId",
          "orgName",
          "category",
          "tags",
          "url",
          "cost",
          "source",
          "confidence",
          "isCanceled"
        ]
      },
      "Category": {
        "type": "string",
        "enum": [
          "academic",
          "class",
          "club",
          "arts",
          "athletics",
          "food",
          "social",
          "career",
          "wellness",
          "admin"
        ]
      },
      "EventDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": ["string", "null"]
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": ["string", "null"]
          },
          "allDay": {
            "type": "boolean"
          },
          "lat": {
            "type": ["number", "null"]
          },
          "lng": {
            "type": ["number", "null"]
          },
          "placeId": {
            "type": ["string", "null"]
          },
          "placeName": {
            "type": ["string", "null"]
          },
          "locationRaw": {
            "type": ["string", "null"]
          },
          "orgId": {
            "type": ["string", "null"]
          },
          "orgName": {
            "type": ["string", "null"]
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": ["string", "null"]
          },
          "cost": {
            "type": ["string", "null"]
          },
          "source": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "isCanceled": {
            "type": "boolean"
          },
          "mergedSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "org": {
            "$ref": "#/components/schemas/Org"
          },
          "place": {
            "$ref": "#/components/schemas/Place"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "start",
          "end",
          "allDay",
          "lat",
          "lng",
          "placeId",
          "placeName",
          "locationRaw",
          "orgId",
          "orgName",
          "category",
          "tags",
          "url",
          "cost",
          "source",
          "confidence",
          "isCanceled",
          "org",
          "place"
        ]
      },
      "Org": {
        "type": ["object", "null"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/OrgKind"
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": ["string", "null"]
              }
            ]
          },
          "description": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "instagram": {
            "type": ["string", "null"]
          },
          "defaultPlaceId": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "category",
          "description",
          "url",
          "instagram",
          "defaultPlaceId"
        ]
      },
      "OrgKind": {
        "type": "string",
        "enum": ["club", "department", "office", "athletics", "external"]
      },
      "Place": {
        "type": ["object", "null"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "$ref": "#/components/schemas/PlaceKind"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "address": {
            "type": ["string", "null"]
          }
        },
        "required": ["id", "name", "aliases", "kind", "lat", "lng", "address"]
      },
      "PlaceKind": {
        "type": "string",
        "enum": [
          "academic",
          "residence",
          "dining",
          "athletic",
          "library",
          "admin",
          "outdoor",
          "other"
        ]
      },
      "PlacesResponse": {
        "type": "object",
        "properties": {
          "places": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Place"
            }
          }
        },
        "required": ["places"]
      },
      "PlaceActivity": {
        "type": "object",
        "properties": {
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meeting"
            }
          }
        },
        "required": ["place", "events", "meetings"]
      },
      "Meeting": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "courseCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "instructor": {
            "type": ["string", "null"]
          },
          "days": {
            "type": "string"
          },
          "startTime": {
            "type": "string"
          },
          "endTime": {
            "type": "string"
          },
          "locationRaw": {
            "type": ["string", "null"]
          },
          "placeId": {
            "type": ["string", "null"]
          },
          "placeName": {
            "type": ["string", "null"]
          },
          "room": {
            "type": ["string", "null"]
          },
          "lat": {
            "type": ["number", "null"]
          },
          "lng": {
            "type": ["number", "null"]
          }
        },
        "required": [
          "id",
          "courseCode",
          "title",
          "instructor",
          "days",
          "startTime",
          "endTime",
          "locationRaw",
          "placeId",
          "placeName",
          "room",
          "lat",
          "lng"
        ]
      },
      "OrgsResponse": {
        "type": "object",
        "properties": {
          "orgs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Org"
            }
          }
        },
        "required": ["orgs"]
      },
      "OrgDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/OrgKind"
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": ["string", "null"]
              }
            ]
          },
          "description": {
            "type": ["string", "null"]
          },
          "url": {
            "type": ["string", "null"]
          },
          "instagram": {
            "type": ["string", "null"]
          },
          "defaultPlaceId": {
            "type": ["string", "null"]
          },
          "upcoming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "past": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "category",
          "description",
          "url",
          "instagram",
          "defaultPlaceId",
          "upcoming",
          "past"
        ]
      },
      "MeetingsResponse": {
        "type": "object",
        "properties": {
          "meetings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meeting"
            }
          }
        },
        "required": ["meetings"]
      },
      "Now": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "meetings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meeting"
            }
          },
          "countsByCategory": {
            "type": "object",
            "properties": {
              "academic": {
                "type": "number"
              },
              "class": {
                "type": "number"
              },
              "club": {
                "type": "number"
              },
              "arts": {
                "type": "number"
              },
              "athletics": {
                "type": "number"
              },
              "food": {
                "type": "number"
              },
              "social": {
                "type": "number"
              },
              "career": {
                "type": "number"
              },
              "wellness": {
                "type": "number"
              },
              "admin": {
                "type": "number"
              }
            }
          }
        },
        "required": ["events", "meetings", "countsByCategory"]
      },
      "Health": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceHealth"
            }
          }
        },
        "required": ["sources"]
      },
      "SourceHealth": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["ok", "error", "partial", "never"]
          },
          "lastRunAt": {
            "type": ["string", "null"]
          },
          "lastOkAt": {
            "type": ["string", "null"]
          },
          "itemsUpserted": {
            "type": ["number", "null"]
          },
          "error": {
            "type": ["string", "null"]
          },
          "staleAfterSeconds": {
            "type": ["integer", "null"]
          },
          "enabled": {
            "type": "boolean"
          },
          "label": {
            "type": ["string", "null"]
          }
        },
        "required": ["source", "status", "lastRunAt", "lastOkAt", "itemsUpserted", "error"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/me": {
      "get": {
        "summary": "Authenticated BrownSync identity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified Brown Google identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Brown Google membership required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Authentication temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/account": {
      "delete": {
        "summary": "Delete the authenticated BrownSync account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Account deleted"
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Brown Google membership and recent OAuth authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Authenticated write rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Account service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Canonical events, filterable by time window, bbox, category, and text",
        "description": "Time filtering is overlap semantics. Defaults: from=now, to=from+7 days. bbox is 'w,s,e,n' (lng/lat). q ranks substring hits above trigram-fuzzy hits.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$"
            },
            "required": false,
            "name": "bbox",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/Category"
            },
            "required": false,
            "name": "category",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": false,
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching canonical events (max 500)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query/path parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "summary": "One event with org and place expanded",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query/path parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/places": {
      "get": {
        "summary": "The campus gazetteer",
        "responses": {
          "200": {
            "description": "All places, name-sorted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/places/{id}/activity": {
      "get": {
        "summary": "A place plus everything happening there around instant `at`",
        "description": "Events overlapping [at, at+24h] and course meetings in session at `at`. Default at=now.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "at",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Place, events, meetings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceActivity"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query/path parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs": {
      "get": {
        "summary": "All organizations",
        "responses": {
          "200": {
            "description": "All organizations, name-sorted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgsResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/orgs/{id}": {
      "get": {
        "summary": "One organization with upcoming and past events",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "at",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Org detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgDetail"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query/path parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "No such resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings": {
      "get": {
        "summary": "Course meetings in session at instant `at`",
        "description": "Server expands weekly day patterns + America/New_York times against the term calendar. Default at=now.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "at",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Meetings in session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed query/path parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/now": {
      "get": {
        "summary": "Default live view: events in progress or starting within 2h, meetings, counts",
        "responses": {
          "200": {
            "description": "Events, meetings, countsByCategory (all 10 keys)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Now"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Per-source ingestion health from source_runs",
        "responses": {
          "200": {
            "description": "Latest run + latest ok per source; 'never' if no runs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
