{
  "name": "@brownsync/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BrownSync design system: §6 tokens as CSS + Tailwind v4 theme, re-themed Radix primitives, 10 hand-drawn category glyphs (DOM sprite + MapLibre addImage variants), and the /dev/ui gallery.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite dev --config dev/vite.config.ts",
    "build": "vite build --config dev/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@brownsync/contract": "workspace:*",
    "@fontsource-variable/instrument-sans": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
