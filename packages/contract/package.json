{
  "name": "@brownsync/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for BrownSync types: Zod schemas mirroring DATA_CONTRACT.md §1/§3/§6, the category taxonomy (§4), and design tokens (handoff §6.1).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
