{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!ingest",
      "!db/seeds",
      "!reports",
      "!supabase",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!cab_*_batches*",
      "!fall_2026_cab_*",
      "!scrape-work",
      "!sheet-work",
      "!ingestion-worktree",
      "!cab_*.js",
      "!brownsync_public_data*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
